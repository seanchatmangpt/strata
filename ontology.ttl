# Strata root ontology — core vocabulary for the Strata family.
# [ontology] source declared by ggen.toml. Per-pack detail lives in each
# pack's own ontology.ttl (aligned here via rdfs:seeAlso); this file defines
# the shared core classes, properties, and seed individuals the pack
# templates consume.

@prefix st:   <https://strata.chatman.ai/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pn:   <https://strata.chatman.ai/ontology/pn64#> .

<https://strata.chatman.ai/ontology> a owl:Ontology ;
    rdfs:label "Strata Ontology" ;
    rdfs:comment "Root ontology for the Strata system: CLAP frames, quads, attestations, witness valves, actuation arenas, Merkle commits, knowledge wormholes, fuel leases, coordinate masks." ;
    owl:imports
        <https://strata.chatman.ai/ontology/protocol> ,
        <https://strata.chatman.ai/ontology/temprun> ,
        <https://strata.chatman.ai/ontology/stratus> ,
        <https://strata.chatman.ai/ontology/cas> ,
        <https://strata.chatman.ai/ontology/signer> .

# ── Pack alignment (rdfs:seeAlso to each pack's ontology.ttl) ────────

<https://strata.chatman.ai/ontology/protocol> rdfs:seeAlso
    <file:///Users/sac/ggen-marketplace/packs/strata-protocol-pack/ontology.ttl> .
<https://strata.chatman.ai/ontology/temprun> rdfs:seeAlso
    <file:///Users/sac/ggen-marketplace/packs/strata-temprun-pack/ontology.ttl> .
<https://strata.chatman.ai/ontology/stratus> rdfs:seeAlso
    <file:///Users/sac/ggen-marketplace/packs/strata-stratus-pack/ontology.ttl> .
<https://strata.chatman.ai/ontology/cas> rdfs:seeAlso
    <file:///Users/sac/ggen-marketplace/packs/strata-cas-pack/ontology.ttl> .
<https://strata.chatman.ai/ontology/signer> rdfs:seeAlso
    <file:///Users/sac/ggen-marketplace/packs/strata-signer-pack/ontology.ttl> .

# ── Core classes ─────────────────────────────────────────────────────

st:ClapFrame a rdfs:Class ; rdfs:label "ClapFrame" ;
    rdfs:comment "A framed CLAP protocol data unit with magic/version header." .

st:Quad a rdfs:Class ; rdfs:label "Quad" ;
    rdfs:comment "A subject/predicate/object/graph coordinate record." .

st:AttestationReceipt a rdfs:Class ; rdfs:label "AttestationReceipt" ;
    rdfs:comment "A five-field receipt (identity/authority/consequence/replay/standing) bound to an actuation and signed by an attestation key." .

st:WitnessValve a rdfs:Class ; rdfs:label "WitnessValve" ;
    rdfs:comment "A gate that admits or refuses a state transition based on witnessed evidence." .

st:ActuationArena a rdfs:Class ; rdfs:label "ActuationArena" ;
    rdfs:comment "A bounded execution arena in which actuations run under fuel leases." .

st:MerkleCommit a rdfs:Class ; rdfs:label "MerkleCommit" ;
    rdfs:comment "A Merkle-rooted commit over a quad graph." .

st:KnowledgeWormhole a rdfs:Class ; rdfs:label "KnowledgeWormhole" ;
    rdfs:comment "A content-addressed link between two graph coordinates." .

st:FuelLease a rdfs:Class ; rdfs:label "FuelLease" ;
    rdfs:comment "A leased budget of actuation fuel granted to a run." .

st:CoordinateMask a rdfs:Class ; rdfs:label "CoordinateMask" ;
    rdfs:comment "A mask over graph coordinates scoping which quads a frame or commit covers." .

# ── Digest / universe properties ─────────────────────────────────────

st:parentDigest a rdf:Property ; rdfs:label "parent digest" ;
    rdfs:domain st:MerkleCommit ; rdfs:range xsd:string ;
    rdfs:comment "Digest of the parent commit (causal lineage)." .

st:universeDigest a rdf:Property ; rdfs:label "universe digest" ;
    rdfs:range xsd:string ;
    rdfs:comment "Digest of the graph universe a frame, commit, or mask covers." .

st:permutationIndex a rdf:Property ; rdfs:label "permutation index" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Index into the canonical permutation of the coordinate space." .

st:nonce a rdf:Property ; rdfs:label "nonce" ;
    rdfs:range xsd:string ;
    rdfs:comment "Freshness nonce binding a frame or receipt to one use." .

# ── Fuel properties ──────────────────────────────────────────────────

st:fuelLease a rdf:Property ; rdfs:label "fuel lease" ;
    rdfs:domain st:ActuationArena ; rdfs:range st:FuelLease ;
    rdfs:comment "The fuel lease under which an actuation runs." .

st:fuelConsumed a rdf:Property ; rdfs:label "fuel consumed" ;
    rdfs:domain st:FuelLease ; rdfs:range xsd:integer ;
    rdfs:comment "Fuel consumed against the lease so far." .

# ── Causal lineage predicates ────────────────────────────────────────

st:causedBy a rdf:Property ; rdfs:label "caused by" ;
    rdfs:comment "Direct causal predecessor (any strata artifact)." .

st:derivedFrom a rdf:Property ; rdfs:label "derived from" ;
    rdfs:comment "Content-lineage predecessor: this artifact's digest was computed over its derivation parent." .

st:attestsTo a rdf:Property ; rdfs:label "attests to" ;
    rdfs:comment "The artifact a receipt or signature witnesses." .

# ── Seed individuals (consumed by pack template SPARQL) ──────────────

st:ClapFrameV1 a st:ClapFrame ;
    st:magic "CLAP" ;
    st:version 1 ;
    st:frameType "data" ;
    st:universeDigest "sha256:strata-genesis" ;
    st:nonce "nonce-genesis-0001" .

st:GenesisCommit a st:MerkleCommit ;
    st:merkleRoot "sha256:strata-genesis-root" ;
    st:universeDigest "sha256:strata-genesis" ;
    st:permutationIndex 0 ;
    st:nonce "nonce-genesis-0001" .

st:DefaultFuelLease a st:FuelLease ;
    st:leaseFuel 1000000 ;
    st:fuelConsumed 0 ;
    st:leaseHolder "strata-default" ;
    st:runsIn st:DefaultArena .

st:GenesisWormhole a st:KnowledgeWormhole ;
    st:sourceDigest "sha256:strata-genesis" ;
    st:targetDigest "sha256:strata-genesis-root" .

st:GenesisMask a st:CoordinateMask ;
    st:universeDigest "sha256:strata-genesis" ;
    st:permutationIndex 0 .

st:GenesisReceipt a st:AttestationReceipt ;
    st:receiptIdentity "receipt:strata-genesis" ;
    st:receiptAuthority "BRCE" ;
    st:receiptConsequence "strata genesis universe admitted" ;
    st:receiptReplay "git+sha256:strata-genesis-root" ;
    st:receiptStanding "ALIVE" ;
    st:nonce "nonce-genesis-0001" ;
    st:causedBy st:GenesisCommit .

# ── PN64 / OCEL64 vocabulary ─────────────────────────────────────────
# 16 place slots packed into a u16 status word; transitions are RONR
# opcode individuals with pre/post masks over that word. Integer values
# below are the hex constants of the PN64 ABI in decimal (e.g. 0x0081=129).

pn:Place a rdfs:Class ; rdfs:label "Place" ;
    rdfs:comment "One of 16 PN64 place slots packed into the u16 status word." .

pn:Transition a rdfs:Class ; rdfs:label "Transition" ;
    rdfs:comment "A PN64 transition with opcode and pre/post masks over the status word." .

pn:DaoVerb a rdfs:Class ; rdfs:label "DaoVerb" ;
    rdfs:comment "DAO action verb sector (high nibble sector class)." .

pn:DaoNoun a rdfs:Class ; rdfs:label "DaoNoun" ;
    rdfs:comment "DAO action noun sector (object class)." .

pn:bitOffset a rdf:Property ; rdfs:label "bit offset" ;
    rdfs:domain pn:Place ; rdfs:range xsd:integer ;
    rdfs:comment "Bit offset of a place slot within the u16 status word." .

pn:opcode a rdf:Property ; rdfs:label "opcode" ;
    rdfs:domain pn:Transition ; rdfs:range xsd:integer .

pn:preMask a rdf:Property ; rdfs:label "pre mask" ;
    rdfs:domain pn:Transition ; rdfs:range xsd:integer ;
    rdfs:comment "Required status-word bits before firing." .

pn:postMask a rdf:Property ; rdfs:label "post mask" ;
    rdfs:domain pn:Transition ; rdfs:range xsd:integer ;
    rdfs:comment "Status-word bits set after firing." .

pn:value a rdf:Property ; rdfs:label "value" ;
    rdfs:range xsd:integer ;
    rdfs:comment "Named-constant byte value of a DAO verb or noun." .

# Place slots 0..15 (pn:slot0 = bit 0 ... pn:slot15 = bit 15)
pn:slot0 a pn:Place ; pn:bitOffset 0 .
pn:slot1 a pn:Place ; pn:bitOffset 1 .
pn:slot2 a pn:Place ; pn:bitOffset 2 .
pn:slot3 a pn:Place ; pn:bitOffset 3 .
pn:slot4 a pn:Place ; pn:bitOffset 4 .
pn:slot5 a pn:Place ; pn:bitOffset 5 .
pn:slot6 a pn:Place ; pn:bitOffset 6 .
pn:slot7 a pn:Place ; pn:bitOffset 7 .
pn:slot8 a pn:Place ; pn:bitOffset 8 .
pn:slot9 a pn:Place ; pn:bitOffset 9 .
pn:slot10 a pn:Place ; pn:bitOffset 10 .
pn:slot11 a pn:Place ; pn:bitOffset 11 .
pn:slot12 a pn:Place ; pn:bitOffset 12 .
pn:slot13 a pn:Place ; pn:bitOffset 13 .
pn:slot14 a pn:Place ; pn:bitOffset 14 .
pn:slot15 a pn:Place ; pn:bitOffset 15 .

# RONR canonical six transitions (0x01..0x06)
pn:MoveMainMotion a pn:Transition ;
    pn:opcode 1 ; pn:preMask 129 ; pn:postMask 130 .

pn:SecondMotion a pn:Transition ;
    pn:opcode 2 ; pn:preMask 2 ; pn:postMask 12 .

pn:MoveToAmend a pn:Transition ;
    pn:opcode 3 ; pn:preMask 8 ; pn:postMask 16 .

pn:AdoptAmendment a pn:Transition ;
    pn:opcode 4 ; pn:preMask 16 ; pn:postMask 8 .

pn:CallPreviousQuestion a pn:Transition ;
    pn:opcode 5 ; pn:preMask 8 ; pn:postMask 96 .

pn:VoteAdoptMainMotion a pn:Transition ;
    pn:opcode 6 ; pn:preMask 36 ; pn:postMask 257 .

# DAO verbs (Propose 0x01 .. AcquireLease 0x94)
pn:Propose a pn:DaoVerb ; pn:value 1 .
pn:Second a pn:DaoVerb ; pn:value 2 .
pn:Amend a pn:DaoVerb ; pn:value 3 .
pn:ExecuteTransaction a pn:DaoVerb ; pn:value 11 .
pn:Ragequit a pn:DaoVerb ; pn:value 116 .
pn:Delegate a pn:DaoVerb ; pn:value 144 .
pn:AcquireLease a pn:DaoVerb ; pn:value 148 .

# DAO nouns (MainProposal 0x01 .. ReceiptRoot 0x92)
pn:MainProposal a pn:DaoNoun ; pn:value 1 .
pn:ExecutiveSpell a pn:DaoNoun ; pn:value 2 .
pn:TreasuryVault a pn:DaoNoun ; pn:value 96 .
pn:EscrowContract a pn:DaoNoun ; pn:value 98 .
pn:ExecutionLease a pn:DaoNoun ; pn:value 145 .
pn:ReceiptRoot a pn:DaoNoun ; pn:value 146 .
